{
  "name": "@smm/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "engagement-worker": "dotenv -e ../../.env -- tsx watch src/engagement-worker.ts",
    "build": "tsc",
    "bundle": "node scripts/build.mjs",
    "start": "node --env-file=../../.env dist/index.js",
    "start:prod": "node dist/prod.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^5.22.0",
    "@smm/db": "workspace:*",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "dotenv-cli": "^7.4.4",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
